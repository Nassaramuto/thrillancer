# THRILLANCER: copy to .env (never commit .env). Only variables the code reads today are listed as active.

# --- Milestone 1 (active) ---------------------------------------------------------------------
# PostgreSQL. `npm run db:dev` starts a local one matching this URL (no Docker needed).
DATABASE_URL=postgresql://zeitgeist:zeitgeist@localhost:5432/zeitgeist
# Exact origin of the web client. The API only allows credentialed requests from this origin.
PUBLIC_APP_ORIGIN=http://localhost:5173
# Server listen port.
PORT=2567
# Server-only secret (>= 32 chars) that signs room tickets. Required when NODE_ENV=production;
# in development a random per-process secret is used if empty. Generate: openssl rand -hex 32
SESSION_SECRET=
# Players per plaza room before a second room is opened (target test size is 10-20).
PLAZA_MAX_CLIENTS=24
# Guest-creation attempts allowed per IP per minute.
GUEST_RATE_PER_MIN=20

# --- Web client (read by Vite at build/dev time; these are public, never put secrets here) ---
VITE_API_URL=http://localhost:2567
VITE_COLYSEUS_URL=ws://localhost:2567

# --- Milestone 2 (NOT read yet; reserved) ------------------------------------------------------
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
DEVNET_PAYMENT_RECIPIENT=

# --- Tests (optional) --------------------------------------------------------------------------
# Admin connection used by integration tests to create throwaway databases.
# TEST_DATABASE_ADMIN_URL=postgresql://zeitgeist:zeitgeist@localhost:5432/postgres
